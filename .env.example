# Zeabur supplies PORT automatically.
# Set one long random value in production. If omitted, AstraNote creates a
# persistent secret in DATA_DIR; keep that directory on a persistent volume.
ASTRANOTE_SECRET=

# Required to enable AstraConfidential SCHybrid. Generate an independent value:
# node -e "console.log(require('node:crypto').randomBytes(64).toString('base64url'))"
# Never reuse ASTRANOTE_SECRET and never change or lose this value in production.
ASTRANOTE_VAULT_SECRET=

# Optional. Defaults to ./data.
# DATA_DIR=/data
