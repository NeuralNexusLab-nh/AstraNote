# Zeabur supplies PORT automatically.
# Set one long random value in production. If omitted, AstraNote creates a
# persistent secret in DATA_DIR; keep that directory on a persistent volume.
ASTRANOTE_SECRET=

# Keep this value unchanged only for existing AstraConfidential SCHybrid notes.
# New notes no longer use it. Generate an independent value if legacy notes exist:
# node -e "console.log(require('node:crypto').randomBytes(64).toString('base64url'))"
# Never reuse ASTRANOTE_SECRET and never change or lose this value in production.
ASTRANOTE_VAULT_SECRET=

# Required for newly created AES-128-GCM, AES-256-GCM, and AstraConfidential
# notes. Generate one independent 64-byte value and keep it unchanged:
# node -e "console.log(require('node:crypto').randomBytes(64).toString('base64url'))"
# Never reuse either legacy secret. Losing or changing this value makes notes
# created with the new encryption versions unreadable.
ASTRA_CONFIDENTIAL_KEY=

# Server-only credential for creating and verifying AstraNote plan payments.
# Never expose this value to browser code, logs, screenshots, or Git.
SATORA_API_KEY=

# Optional. Defaults to ./data.
# DATA_DIR=/data
